begin unit_cell_cart
Ang
         3.7685000000     0.0000000000     0.0000000000
         0.0000000000     3.7685000000     0.0000000000
         0.0000000000     0.0000000000     5.5194000000
end unit_cell_cart

begin atoms_frac
Fe           0.7500000000       0.2500000000       0.0000000000
Fe           0.2500000000       0.7500000000       0.0000000000
Se           0.2500000000       0.2500000000       0.2313200000
Se           0.7500000000       0.7500000000       0.7686800000
end atoms_frac

! system
num_wann = 16
num_bands = 16
mp_grid 8 8 4

! job control
exclude_bands : 1-2
iprint = 2

! plotting
wannier_plot = false
wannier_plot_supercell = 3
bands_plot = true
bands_num_points = 80
bands_plot_format = gnuplot
write_hr = true
write_u_matrices = true

! disentanglement
!dis_win_min = 11.0
!dis_win_max = 14.0
!dis_froz_min = 11.0
!dis_froz_max = 13.3
!dis_num_iter = 1000
!dis_conv_tol = 1.0E-9
!dis_mix_ratio = 0.9

! wannierisation
num_iter = 5000
conv_window = 5
conv_tol = 1e-12

begin kpoint_path
G 0.000 0.000 0.000 X 0.000 0.500 0.000
X 0.000 0.500 0.000 M 0.500 0.500 0.000
M 0.500 0.500 0.000 G 0.000 0.000 0.000
G 0.000 0.000 0.000 Z 0.000 0.000 0.500
Z 0.000 0.000 0.500 R 0.000 0.500 0.500
R 0.000 0.500 0.500 A 0.500 0.500 0.500
A 0.500 0.500 0.500 Z 0.000 0.000 0.500
end kpoint_path

begin projections
Fe:dxy,dyz,dz2,dxz,dx2-y2
Se:px,py,pz
end projections

